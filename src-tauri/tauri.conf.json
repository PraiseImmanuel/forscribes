{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForScribe",
  "version": "0.1.3",
  "identifier": "com.forscribe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ForScribe",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/forscribe-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRTc5QzM3MjU1NEFBQTQKUldTa3FsUWxONXpuazBvOHVvNk9qOE5oazFuSWxBWUhXZlBJN2Y4U09UN0VYcjVqY01vd1FrM2cK",
      "endpoints": [
        "https://github.com/PraiseImmanuel/forscribes/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
