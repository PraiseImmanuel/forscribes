# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python sidecar
python-sidecar/.venv
python-sidecar/__pycache__
python-sidecar/**/__pycache__
python-sidecar/*.spec
python-sidecar/build
python-sidecar/dist

# Rust build output (huge, regenerated by `cargo build` / `tauri build`)
src-tauri/target

# Bundled sidecar exe - regenerated by build_sidecar.py before every release
src-tauri/binaries/*.exe

# Updater signing key - losing gitignore on these would let anyone sign fake
# updates as us, and there's no way to revoke a leaked key after the fact.
src-tauri/forscribe-updater.key
src-tauri/UPDATER_KEY_PASSWORD.txt
